# ==========================================
# Express Backend Environment Configuration
# ==========================================

# Server Port & URL
PORT=5000
SERVER_URL=http://localhost:5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/playlist_service
# Alternatively for Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/playlist_service?retryWrites=true&w=majority

# JWT Secret Key (MUST match Jwt__SecretKey in PlaylistService.Auth/.env)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here

# Genius API Access Token (for lyrics and track metadata search)
GENIUS_ACCESS_TOKEN=your_genius_client_access_token_here

# File Upload Settings
UPLOAD_DIR=uploads
