# ==========================================
# Backend Environment Configuration (.env.example)
# Rename to .env and fill in your values
# ==========================================

# Server Configuration
SERVER_URL=http://localhost:5000/api
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGO_URI=mongodb://localhost:27017/musicdb
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=musicdb

# Clerk Authentication (Get keys at https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# AI Service Configuration
AI_SERVICE_URL=http://localhost:5001/api/ai

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_HTTPS=https://localhost:3000

# Logging
LOG_LEVEL=debug

# Genius API Configuration (Get token at https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=your_genius_access_token_here
