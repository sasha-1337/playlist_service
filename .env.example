# ==========================================
# Frontend Environment Configuration (React 19)
# ==========================================

# Base URL for Express Backend API (Music Library & Genius Proxy)
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Base URL for .NET Authentication Service (PlaylistService.Auth)
REACT_APP_AUTH_SERVICE_API_URL=https://localhost:7001/api/auth

# Optional AI Microservice URL (FastAPI / PyTorch embeddings)
REACT_APP_AI_API_URL=http://localhost:8000/api

# Google OAuth 2.0 Client ID (from Google Cloud Console)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Enable Debug Logging (optional)
REACT_APP_DEBUG=true
