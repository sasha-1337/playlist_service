# ==========================================
# Frontend Environment Configuration (.env.example)
# Rename to .env and fill in your values
# ==========================================

# Backend API URL
REACT_APP_API_BASE_URL=http://localhost:5000/api
REACT_APP_API_PORT=5000

# Clerk Authentication (Get keys at https://dashboard.clerk.com)
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# AI Service URL
REACT_APP_AI_API_URL=http://localhost:5001/api/ai
REACT_APP_AI_SERVICE_PORT=5001

# Environment
REACT_APP_ENV=development
REACT_APP_LOG_LEVEL=debug

# Optional: Enable React DevTools
REACT_APP_ENABLE_DEV_TOOLS=true
